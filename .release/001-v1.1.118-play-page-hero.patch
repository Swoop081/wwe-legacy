@@ -0,0 +1,31 @@
+/* v1.1.118 — fill Play page one and feature Live Events first. */
+@media (max-width:600px){
+  .legacy-play-v3.play-menu-page-1{min-height:calc(100svh - 188px);height:calc(100svh - 188px);display:grid;grid-template-rows:auto minmax(0,1fr) auto;gap:8px;padding-bottom:4px;overflow:hidden}
+  .play-menu-page-1 .legacy-play-heading{padding-block:4px 2px;margin:0}
+  .play-menu-page-1 .legacy-play-heading h2{font-size:clamp(29px,8.2vw,38px);line-height:.92;margin:0}
+  .play-menu-page-1 .legacy-play-heading p{margin:3px 0 0;font-size:12px}
+  .play-menu-page-1 .legacy-mode-stack{display:grid;grid-template-rows:minmax(0,1.34fr) minmax(0,.86fr) minmax(0,.86fr);gap:7px;min-height:0}
+  .play-menu-page-1 .legacy-mode-banner{min-height:0;height:100%;margin:0;border-radius:10px;overflow:hidden}
+  .play-menu-page-1 .play-page-feature-hero .legacy-mode-superstar{width:47%;right:-1%;transform:scale(1.08);transform-origin:bottom right}
+  .play-menu-page-1 .play-page-feature-hero .legacy-mode-copy{width:61%;padding:14px 8px 12px 14px}
+  .play-menu-page-1 .play-page-feature-hero .mode-logo span,.play-menu-page-1 .play-page-feature-hero .mode-logo strong{font-size:clamp(34px,10vw,50px);line-height:.82}
+  .play-menu-page-1 .play-page-feature-hero .legacy-mode-copy>b{font-size:13px;padding:10px 12px;margin-top:8px}
+  .play-menu-page-1 .play-page-compact-mode .legacy-mode-superstar{width:34%;right:0}
+  .play-menu-page-1 .play-page-compact-mode .legacy-mode-copy{width:70%;padding:9px 7px 8px 12px}
+  .play-menu-page-1 .play-page-compact-mode .mode-logo span,.play-menu-page-1 .play-page-compact-mode .mode-logo strong{font-size:clamp(25px,7.2vw,34px);line-height:.84}
+  .play-menu-page-1 .play-page-compact-mode .legacy-mode-copy em{font-size:9px}
+  .play-menu-page-1 .play-page-compact-mode .legacy-mode-copy small{font-size:9px;line-height:1.08;margin-top:2px}
+  .play-menu-page-1 .play-page-compact-mode .legacy-mode-copy>b{font-size:11px;padding:7px 9px;margin-top:5px}
+  .play-menu-page-1 .play-mode-page-arrow{min-height:54px;height:54px;margin:0;padding:0 18px;border-radius:9px}
+  .play-menu-page-1 .play-mode-page-arrow span{font-size:12px}
+  .play-menu-page-1 .play-mode-page-arrow b{font-size:34px}
+}
